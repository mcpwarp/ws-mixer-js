{
  "name": "@mcpwarp/ws-mixer",
  "version": "0.9.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "description": "ws-mixer.v1 client SDK and mcpwarp helper: N byte streams over one WebSocket, platform-neutral JS/TypeScript.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpwarp/ws-mixer-js.git"
  },
  "homepage": "https://github.com/mcpwarp/ws-mixer-js#readme",
  "bugs": {
    "url": "https://github.com/mcpwarp/ws-mixer-js/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcpwarp": {
      "types": "./dist/mcpwarp/index.d.ts",
      "default": "./dist/mcpwarp/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/check-registry.mjs && npm run build && npm run check:neutral",
    "build": "tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.neutral.json",
    "check:neutral": "node scripts/check-neutral.mjs",
    "smoke:deno": "deno run scripts/deno-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-spec": "node scripts/fetch-spec.mjs",
    "fetch-goserver": "node scripts/fetch-goserver.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.0.0"
  }
}
